{
  "name": "timeclock",
  "version": "1.0.0",
  "description": "**⚠️ 重要：不要直接雙擊 `index.html`（file:// 模式）**。Firebase SDK 需要 http/https 環境，`file://` 下會拋 `postMessage` origin 錯誤、雲端同步與登入無法運作。",
  "main": "app.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./output.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17"
  }
}
