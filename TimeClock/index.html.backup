<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Da Ka - 打卡</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Fira+Code:wght@400;600&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --bg-dark: #0d1117;
    --bg-card: #161b22;
    --bg-card-hover: #1c2128;
    --bg-input: #010409;
    --border-code: #30363d;
    --border-hover: #8b949e;
    --border-active: #58a6ff;
    --text-primary: #f0f6fc;
    --text-secondary: #c9d1d9;
    --text-muted: #8b949e;
    --accent-blue: #58a6ff;
    --accent-green: #3fb950;
    --accent-purple: #bc8cff;
    --accent-amber: #d29922;
    --accent-red: #f85149;
    --accent-cyan: #39c5cf;
    --commute: #58a6ff;
    --work: #3fb950;
    --shopping: #bc8cff;
    --danger: #f85149;
    --shadow-code: 0 10px 30px rgba(0, 0, 0, 0.4);
    --shadow-glow: 0 0 16px rgba(88, 166, 255, 0.15);
    --radius-code: 8px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { min-height: 100%; }

  body {
    font-family: 'JetBrains Mono', 'Fira Code', 'Inter', monospace, sans-serif;
    background-color: var(--bg-dark);
    background-image: 
      radial-gradient(circle at 10% 10%, rgba(88, 166, 255, 0.05) 0%, transparent 40%),
      radial-gradient(circle at 90% 90%, rgba(63, 185, 80, 0.05) 0%, transparent 40%),
      linear-gradient(to right, rgba(255, 255, 255, 0.015) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 24px 24px, 24px 24px;
    background-attachment: fixed;
    color: var(--text-primary);
    font-size: 12px;
    line-height: 1.5;
    min-height: 100vh;
    padding: 20px 16px 40px;
    position: relative;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Coding Terminal Ambient Header Overlay */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #58a6ff 0%, #3fb950 50%, #bc8cff 100%);
    z-index: 9999;
  }

  .app {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* IDE Window Card Container */
  .topbar,
  .hero,
  .panel {
    border: 1px solid var(--border-code);
    background: var(--bg-card);
    box-shadow: var(--shadow-code);
    border-radius: var(--radius-code);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Topbar Styling (Terminal Header) */
  .topbar {
    position: relative;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    background: rgba(22, 27, 34, 0.95);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand h1 {
    font-size: 16px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: -0.3px;
  }

  .brand h1::before {
    content: '$';
    color: var(--accent-green);
    font-weight: 800;
  }

  .brand h1::after {
    content: '▋';
    color: var(--accent-blue);
    font-size: 14px;
    animation: blink 1.1s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .brand p {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
  }

  .status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* Terminal Status Badges */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-code);
    background: var(--bg-input);
    color: var(--text-secondary);
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  .pill strong {
    color: var(--accent-blue);
    font-weight: 700;
  }

  .pill--ok {
    border-color: rgba(63, 185, 80, 0.4);
    background: rgba(63, 185, 80, 0.1);
  }
  .pill--ok strong { color: var(--accent-green); }

  .pill--warn {
    border-color: rgba(210, 153, 34, 0.4);
    background: rgba(210, 153, 34, 0.1);
  }
  .pill--warn strong { color: var(--accent-amber); }

  .pill--selected {
    border-color: rgba(88, 166, 255, 0.4);
    background: rgba(88, 166, 255, 0.1);
  }
  .pill--selected strong { color: var(--accent-blue); }

  /* Coding Agent Command Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .btn {
    appearance: none;
    border: 1px solid var(--border-code);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-1px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-glow);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn-primary {
    background: rgba(88, 166, 255, 0.15);
    border-color: rgba(88, 166, 255, 0.4);
    color: var(--accent-blue);
  }
  .btn-primary:hover {
    background: rgba(88, 166, 255, 0.25);
    border-color: var(--accent-blue);
  }

  .btn-work {
    background: rgba(63, 185, 80, 0.15);
    border-color: rgba(63, 185, 80, 0.4);
    color: var(--accent-green);
  }
  .btn-work:hover {
    background: rgba(63, 185, 80, 0.25);
    border-color: var(--accent-green);
  }

  .btn-shopping {
    background: rgba(188, 140, 255, 0.15);
    border-color: rgba(188, 140, 255, 0.4);
    color: var(--accent-purple);
  }
  .btn-shopping:hover {
    background: rgba(188, 140, 255, 0.25);
    border-color: var(--accent-purple);
  }

  .btn-danger {
    background: rgba(248, 81, 73, 0.12);
    border-color: rgba(248, 81, 73, 0.4);
    color: var(--accent-red);
  }
  .btn-danger:hover {
    background: rgba(248, 81, 73, 0.25);
    border-color: var(--accent-red);
  }

  .btn-ghost {
    background: var(--bg-input);
    border-color: var(--border-code);
    color: var(--text-secondary);
  }
  .btn-ghost:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  /* Dropdown Menu */
  .dropdown { position: relative; z-index: 120; }

  #exportMenu {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 140px;
    border: 1px solid var(--border-code);
    border-radius: 6px;
    overflow: hidden;
    background: #161b22;
    box-shadow: var(--shadow-code);
    z-index: 2000;
  }

  #exportMenu button {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--border-code);
    background: transparent;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
    padding: 10px 14px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  #exportMenu button:hover {
    background: rgba(88, 166, 255, 0.15);
    color: var(--accent-blue);
  }

  #exportMenu button:last-child { border-bottom: 0; }

  /* Main Layout */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.85fr);
    gap: 16px;
    margin-top: 16px;
    align-items: start;
  }

  /* Panels (Editor Windows) */
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border-code);
    background: rgba(1, 4, 9, 0.5);
    font-family: 'JetBrains Mono', monospace;
  }

  .panel-header h3,
  .panel-header h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .panel-header h3::before,
  .panel-header h4::before {
    content: '//';
    color: var(--text-muted);
  }

  .panel-header small {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
  }

  #listHint {
    color: var(--accent-amber);
    font-family: 'JetBrains Mono', monospace;
  }

  .panel-body {
    padding: 16px 18px;
  }

  /* Stats Grid (Telemetry Cards) */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 16px;
  }

  .stat-card {
    border: 1px solid var(--border-code);
    border-radius: 6px;
    padding: 12px;
    background: var(--bg-input);
    transition: border-color 0.15s ease;
  }

  .stat-card:hover {
    border-color: var(--border-hover);
  }

  .stat-card span {
    display: block;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .stat-card strong {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 20px;
    font-weight: 700;
    color: var(--accent-blue);
    line-height: 1.2;
  }

  .stat-card small {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
  }

  /* Info List */
  .info-list {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .info-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--border-code);
    background: var(--bg-input);
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
  }

  .info-list .label { color: var(--text-muted); }
  .info-list .value { 
    color: var(--text-primary); 
    font-weight: 600;
    text-align: right; 
  }

  /* Log List & Group Accordion */
  #log {
    display: grid;
    gap: 12px;
  }

  details.group {
    border: 1px solid var(--border-code);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-input);
    transition: border-color 0.15s ease;
  }

  details.group[open] {
    border-color: var(--border-hover);
  }

  details.group > summary {
    list-style: none;
    cursor: pointer;
    padding: 12px 14px;
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: rgba(22, 27, 34, 0.6);
    border-bottom: 1px solid transparent;
  }

  details.group[open] > summary {
    border-bottom-color: var(--border-code);
  }

  details.group > summary::-webkit-details-marker { display: none; }

  .group-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .group-title strong { 
    color: var(--accent-purple);
  }

  .group-badge {
    font-size: 10px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-code);
    border-radius: 4px;
    padding: 2px 6px;
    white-space: nowrap;
  }

  .entries {
    display: grid;
    gap: 8px;
    padding: 10px;
  }

  /* Single Entry Log Card */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 1.4fr) auto;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--border-code);
    border-radius: 6px;
    background: var(--bg-card);
    padding: 12px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .entry:hover {
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
  }

  .entry-main {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .entry-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .entry-check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
  }

  .entry-check input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: var(--accent-blue);
    cursor: pointer;
  }

  .entry-time {
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
  }

  /* Code Tags */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
  }

  .tag-commute { 
    color: var(--commute); 
    background: rgba(88, 166, 255, 0.12); 
    border-color: rgba(88, 166, 255, 0.3);
  }
  .tag-work { 
    color: var(--work); 
    background: rgba(63, 185, 80, 0.12); 
    border-color: rgba(63, 185, 80, 0.3);
  }
  .tag-shopping { 
    color: var(--shopping); 
    background: rgba(188, 140, 255, 0.12); 
    border-color: rgba(188, 140, 255, 0.3);
  }

  /* Inline Comment Input */
  .entry-note {
    width: 100%;
    border: 1px solid var(--border-code);
    border-radius: 4px;
    background: var(--bg-input);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 7px 10px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .entry-note::placeholder { color: var(--text-muted); }
  .entry-note:focus { 
    border-color: var(--accent-blue); 
    box-shadow: 0 0 0 2px rgba(88, 166, 255, 0.2); 
  }

  .entry-actions {
    display: flex;
    align-items: center;
  }

  .delBtn {
    border: 1px solid rgba(248, 81, 73, 0.3);
    background: rgba(248, 81, 73, 0.1);
    color: var(--accent-red);
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    padding: 6px 10px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .delBtn:hover { 
    background: rgba(248, 81, 73, 0.25);
    border-color: var(--accent-red);
  }

  .toolbar-note {
    padding: 10px 18px;
    font-size: 10px;
    color: var(--text-muted);
    border-top: 1px solid var(--border-code);
    background: rgba(1, 4, 9, 0.5);
    font-family: 'Inter', sans-serif;
  }

  /* Hero Section (Agent Telemetry Summary) */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 1fr);
    gap: 20px;
    padding: 20px;
    margin-top: 16px;
  }

  .hero-copy h2 {
    font-size: 15px;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-primary);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hero-copy h2::before {
    content: '>';
    color: var(--accent-blue);
  }

  .hero-copy p {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.6;
    font-family: 'Inter', sans-serif;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .metric {
    border: 1px solid var(--border-code);
    background: var(--bg-input);
    border-radius: 6px;
    padding: 12px;
    transition: border-color 0.15s ease;
  }

  .metric:hover {
    border-color: var(--border-hover);
  }

  .metric span {
    display: block;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 4px;
    font-family: 'JetBrains Mono', monospace;
  }

  .metric strong {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-green);
    line-height: 1.2;
  }

  .metric em {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-size: 10px;
    color: var(--accent-blue);
    font-family: 'Inter', sans-serif;
  }

  /* Print Styles */
  #printArea {
    display: none;
    color: #000;
    font-family: monospace;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .hero,
    .layout {
      grid-template-columns: 1fr;
    }
    .actions { justify-content: flex-start; }
  }

  @media (max-width: 720px) {
    body { padding: 12px 8px; }
    .topbar { flex-direction: column; align-items: stretch; gap: 12px; padding: 14px; }
    .brand { text-align: center; }
    .status-row, .actions { justify-content: center; }
    .hero { padding: 14px; }
    .hero-metrics, .stats-grid { grid-template-columns: 1fr 1fr; }
    .entry { grid-template-columns: 1fr; gap: 8px; }
    .entry-actions { justify-content: flex-end; }
  }

  @media (max-width: 520px) {
    .hero-metrics, .stats-grid { grid-template-columns: 1fr; }
    .actions { gap: 6px; width: 100%; }
    .btn { width: 100%; justify-content: center; }
    .dropdown { width: 100%; }
    #exportMenu { width: 100%; }
  }

  @media print {
    body { background: #fff; padding: 0; }
    body::before,
    .app { display: none !important; }
    #printArea {
      display: block !important;
      padding: 20px;
    }
    #printArea table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    #printArea th,
    #printArea td {
      border: 1px solid #000;
      padding: 6px 8px;
      text-align: left;
      vertical-align: top;
    }
  }
</style>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <h1>Da Ka - 打卡</h1>
      <p>單頁通勤、工作、購物、備註、匯出、同步</p>
    </div>

    <div class="status-row">
      <div class="pill pill--ok"><strong id="syncBadge">OFFLINE</strong></div>
      <div class="pill"><strong id="recordCountLabel">0</strong> 筆記錄</div>
      <div class="pill pill--selected"><strong id="selectedCountLabel">0</strong> 筆已勾選</div>
    </div>

    <div class="actions">
      <button class="btn btn-primary" id="commuteBtn">🚆 通勤</button>
      <button class="btn btn-work" id="workBtn">🛠 工作</button>
      <button class="btn btn-shopping" id="shoppingBtn">🛒 購物</button>
      <div class="dropdown">
        <button class="btn btn-ghost" id="exportBtn">匯出 ▼</button>
        <div id="exportMenu" aria-label="匯出選單">
          <button type="button" data-export="csv">CSV</button>
          <button type="button" data-export="txt">TXT</button>
          <button type="button" data-export="md">MD</button>
        </div>
      </div>
      <button class="btn btn-danger" id="clearBtn">清除全部</button>
    </div>
  </header>

  <main class="layout">
    <section class="panel panel--primary">
      <div class="panel-header">
        <div>
          <h3>記錄區</h3>
          <small>依日期分組顯示，可直接編輯備註</small>
        </div>
        <small id="listHint">請勾選兩筆以上時間以計算總時數</small>
      </div>
      <div class="panel-body">
        <div id="log"></div>
      </div>
      <div class="toolbar-note">
        同步版使用 Firebase Realtime Database，並保留本機快取以便離線瀏覽。
      </div>
    </section>

    <aside class="panel">
      <div class="panel-header">
        <div>
          <h4>摘要面板</h4>
          <small>快速查看當前狀態</small>
        </div>
        <small id="nowMiniLabel"></small>
      </div>
      <div class="panel-body">
        <div class="stats-grid">
          <div class="stat-card">
            <span>總筆數</span>
            <strong id="recordStat">0</strong>
            <small>全部記錄</small>
          </div>
          <div class="stat-card">
            <span>已勾選</span>
            <strong id="checkedStat">0</strong>
            <small>計算區間用</small>
          </div>
          <div class="stat-card">
            <span>通勤數</span>
            <strong id="commuteCountStat">0</strong>
            <small>通勤類型</small>
          </div>
          <div class="stat-card">
            <span>工作數</span>
            <strong id="workCountStat">0</strong>
            <small>工作類型</small>
          </div>
          <div class="stat-card">
            <span>購物數</span>
            <strong id="shoppingCountStat">0</strong>
            <small>購物類型</small>
          </div>
        </div>

        <ul class="info-list">
          <li><span class="label">儲存方式</span><span class="value">localStorage + Firebase</span></li>
          <li><span class="label">目前時間</span><span class="value" id="sideNowLabel">—</span></li>
          <li><span class="label">同步狀態</span><span class="value" id="syncStateLabel">OFFLINE</span></li>
          <li><span class="label">最近更新</span><span class="value" id="updatedAtLabel">—</span></li>
          <li><span class="label">使用者 ID</span><span class="value" id="userIdLabel">—</span></li>
        </ul>
      </div>
    </aside>
  </main>

  <section class="hero">
    <div class="hero-copy">
      <h2>打卡摘要</h2>
      <p>
        下方是目前選取時間的總工時、通勤、工作、購物與同步狀態。你可以先看上方記錄，再往下核對統計。
      </p>
    </div>
    <div class="hero-metrics">
      <div class="metric">
        <span>總工時</span>
        <strong id="totalLabel">—</strong>
        <em>勾選兩筆以上自動計算</em>
      </div>
      <div class="metric">
        <span>通勤</span>
        <strong id="commuteTotalLabel">—</strong>
        <em>通勤類型區間</em>
      </div>
      <div class="metric">
        <span>工作</span>
        <strong id="workTotalLabel">—</strong>
        <em>工作類型區間</em>
      </div>
      <div class="metric">
        <span>購物</span>
        <strong id="shoppingTotalLabel">—</strong>
        <em>購物類型區間</em>
      </div>
      <div class="metric">
        <span>最後同步</span>
        <strong id="lastSyncLabel">尚未同步</strong>
        <em>每 2 秒檢查一次</em>
      </div>
    </div>
  </section>
</div>

<div id="printArea"></div>

<script>
  const firebaseConfig = {
    apiKey: 'AIzaSyB7k0Zz6Y6Y6Y6Y6Y6Y6Y6Y6Y6Y6Y6Y6',
    authDomain: 'timeclock-sync-98222.firebaseapp.com',
    databaseURL: 'https://timeclock-sync-98222-default-rtdb.europe-west1.firebasedatabase.app',
    projectId: 'timeclock-sync-98222',
    storageBucket: 'timeclock-sync-98222.appspot.com',
    messagingSenderId: '123456789012',
    appId: '1:123456789012:web:abcdef123456'
  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.database();

  let userId = localStorage.getItem('daKaUserId') || 'user-123';
  localStorage.setItem('daKaUserId', userId);
  document.getElementById('userIdLabel').textContent = userId;

  const log = document.getElementById('log');
  const totalLabel = document.getElementById('totalLabel');
  const commuteTotalLabel = document.getElementById('commuteTotalLabel');
  const workTotalLabel = document.getElementById('workTotalLabel');
  const shoppingTotalLabel = document.getElementById('shoppingTotalLabel');
  const recordCountLabel = document.getElementById('recordCountLabel');
  const selectedCountLabel = document.getElementById('selectedCountLabel');
  const recordStat = document.getElementById('recordStat');
  const checkedStat = document.getElementById('checkedStat');
  const commuteCountStat = document.getElementById('commuteCountStat');
  const workCountStat = document.getElementById('workCountStat');
  const shoppingCountStat = document.getElementById('shoppingCountStat');
  const exportMenu = document.getElementById('exportMenu');
  const nowLabel = document.getElementById('nowLabel');
  const nowMiniLabel = document.getElementById('nowMiniLabel');
  const sideNowLabel = document.getElementById('sideNowLabel');
  const syncBadge = document.getElementById('syncBadge');
  const syncStateLabel = document.getElementById('syncStateLabel');
  const lastSyncLabel = document.getElementById('lastSyncLabel');
  const updatedAtLabel = document.getElementById('updatedAtLabel');
  const listHint = document.getElementById('listHint');

  const firebaseDBUrl = `https://timeclock-sync-98222-default-rtdb.europe-west1.firebasedatabase.app/users/${userId}/times.json`;
  const firebaseUserUrl = `https://timeclock-sync-98222-default-rtdb.europe-west1.firebasedatabase.app/users/${userId}.json`;
  const localCacheKey = 'daKaLocalTimes';
  const TYPE_META = { commute: { label: '通勤', className: 'tag-commute' }, work: { label: '工作', className: 'tag-work' }, shopping: { label: '購物', className: 'tag-shopping' } };

  let times = loadLocalCache();
  let syncState = 'OFFLINE';
  let lastSyncAt = '';
  let saveTimer = null;

  function normalizeTimes(list) {
    if (!Array.isArray(list)) return [];
    return list.map((item, index) => ({
      id: item && item.id ? item.id : `${Number(item?.t) || Date.now()}-${index}-${item?.type || 'work'}`,
      t: Number(item?.t) || Date.now(),
      checked: !!item?.checked,
      type: item?.type === 'commute' || item?.type === 'work' || item?.type === 'shopping' ? item.type : (item?.type === 'rest' ? 'shopping' : 'work'),
      note: typeof item?.note === 'string' ? item.note : ''
    }));
  }

  function loadLocalCache() {
    try {
      const raw = localStorage.getItem(localCacheKey);
      return raw ? normalizeTimes(JSON.parse(raw)) : [];
    } catch {
      return [];
    }
  }

  function persistLocalCache() {
    localStorage.setItem(localCacheKey, JSON.stringify(times));
  }

  function fmtDuration(ms) {
    if (typeof ms !== 'number' || Number.isNaN(ms) || ms < 0) return '—';
    const sec = Math.floor(ms / 1000);
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = sec % 60;
    return `${h}h ${m}m ${s}s`;
  }

  function fmtDate(d) {
    const Y = d.getFullYear();
    const M = d.getMonth() + 1;
    const D = d.getDate();
    const h = d.getHours();
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    const ampm = h < 12 ? 'AM' : 'PM';
    const h12 = h % 12 || 12;
    return `${Y} 年 ${M} 月 ${D} 日 ${h12}:${m}:${s} ${ampm}`;
  }

  function fmtEntry(d) {
    const Y = d.getFullYear();
    const M = d.getMonth() + 1;
    const D = d.getDate();
    const h = d.getHours();
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    const ampm = h < 12 ? 'AM' : 'PM';
    const h12 = h % 12 || 12;
    return `${Y}/${M}/${D} ${h12}:${m}:${s} ${ampm}`;
  }

  function csvEscape(value) {
    return `"${String(value ?? '').replaceAll('"', '""')}"`;
  }

  function setSyncState(state, touchedAt) {
    syncState = state;
    if (touchedAt) lastSyncAt = touchedAt;
    syncBadge.textContent = state;
    syncStateLabel.textContent = state;
    lastSyncLabel.textContent = lastSyncAt || '尚未同步';
    updatedAtLabel.textContent = lastSyncAt || '—';
  }

  function queueSave() {
    persistLocalCache();
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(saveToFirebase, 220);
  }

  function getGroupedTimes() {
    const groups = {};
    times.forEach((item, index) => {
      const d = new Date(item.t);
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      if (!groups[key]) groups[key] = [];
      groups[key].push({ item, index });
    });
    return Object.entries(groups).sort((a, b) => b[0].localeCompare(a[0]));
  }

  function calcRange(list) {
    const values = list.map(t => t.t).sort((a, b) => a - b);
    if (values.length < 2) return '';
    return fmtDuration(values[values.length - 1] - values[0]);
  }

  function calcSelectedSummary() {
    const selected = times.filter(t => t.checked);
    const selectedCommute = selected.filter(t => t.type === 'commute');
    const selectedWork = selected.filter(t => t.type === 'work');
    const selectedShopping = selected.filter(t => t.type === 'shopping');
    const total = calcRange(selected);
    const commute = calcRange(selectedCommute);
    const work = calcRange(selectedWork);
    const shopping = calcRange(selectedShopping);

    totalLabel.textContent = total || '—';
    commuteTotalLabel.textContent = commute || '—';
    workTotalLabel.textContent = work || '—';
    shoppingTotalLabel.textContent = shopping || '—';

    const checkedCount = selected.length;
    selectedCountLabel.textContent = checkedCount;
    checkedStat.textContent = checkedCount;
    recordCountLabel.textContent = times.length;
    recordStat.textContent = times.length;
    commuteCountStat.textContent = times.filter(t => t.type === 'commute').length;
    workCountStat.textContent = times.filter(t => t.type === 'work').length;
    shoppingCountStat.textContent = times.filter(t => t.type === 'shopping').length;
    listHint.textContent = checkedCount >= 2 ? `已選 ${checkedCount} 筆，可計算總時數` : '請勾選兩筆以上時間以計算總時數';
  }

  function render() {
    log.innerHTML = '';
    recordCountLabel.textContent = times.length;
    recordStat.textContent = times.length;

    const groups = getGroupedTimes();
    if (!groups.length) {
      const empty = document.createElement('div');
      empty.className = 'stat-card';
      empty.innerHTML = '<span>目前沒有記錄</span><strong>按「通勤 / 工作 / 購物」開始</strong><small>資料會同步到 Firebase 與本機快取</small>';
      log.appendChild(empty);
      calcSelectedSummary();
      return;
    }

    groups.forEach(([date, entries]) => {
      const details = document.createElement('details');
      details.className = 'group';
      details.open = true;

      const summary = document.createElement('summary');
      const totalChecked = entries.filter(({ item }) => item.checked).length;
      summary.innerHTML = `
        <span class="group-title"><strong>${date}</strong><span class="group-badge">${entries.length} 筆 / ${totalChecked} 已勾選</span></span>
        <span class="group-badge">點擊可收合</span>
      `;
      details.appendChild(summary);

      const entriesWrap = document.createElement('div');
      entriesWrap.className = 'entries';

      entries.forEach(({ item, index }) => {
        const row = document.createElement('article');
        row.className = 'entry';

        const main = document.createElement('div');
        main.className = 'entry-main';

        const top = document.createElement('div');
        top.className = 'entry-top';

        const label = document.createElement('label');
        label.className = 'entry-check';

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.dataset.idx = index;
        cb.checked = item.checked;
        cb.addEventListener('change', onCheck);

        const labelText = document.createElement('span');
        labelText.textContent = '勾選';

        const timeText = document.createElement('span');
        timeText.className = 'entry-time';
        timeText.textContent = fmtEntry(new Date(item.t));

        const typeTag = document.createElement('span');
        const meta = TYPE_META[item.type] || TYPE_META.work;
        typeTag.className = `tag ${meta.className}`;
        typeTag.textContent = meta.label;

        label.append(cb, labelText);
        top.append(label, timeText, typeTag);

        const note = document.createElement('input');
        note.className = 'entry-note';
        note.type = 'text';
        note.placeholder = '備註';
        note.value = item.note || '';
        note.dataset.idx = index;
        note.addEventListener('input', onNoteInput);

        main.append(top, note);

        const actions = document.createElement('div');
        actions.className = 'entry-actions';
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'delBtn';
        del.textContent = '刪除';
        del.onclick = e => {
          e.stopPropagation();
          removeEntry(index);
        };
        actions.appendChild(del);

        row.append(main, actions);
        entriesWrap.appendChild(row);
      });

      details.appendChild(entriesWrap);
      log.appendChild(details);
    });

    calcSelectedSummary();
  }

  function addEntry(type) {
    times.push({
      id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      t: Date.now(),
      checked: false,
      type,
      note: ''
    });
    queueSave();
    render();
  }

  function removeEntry(idx) {
    times.splice(idx, 1);
    queueSave();
    render();
  }

  function onCheck(e) {
    const idx = Number(e.target.dataset.idx);
    if (!times[idx]) return;
    times[idx].checked = e.target.checked;
    queueSave();
    calcSelectedSummary();
  }

  function onNoteInput(e) {
    const idx = Number(e.target.dataset.idx);
    if (!times[idx]) return;
    times[idx].note = e.target.value;
    queueSave();
  }

  function exportAs(type) {
    exportMenu.style.display = 'none';
    if (!times.length) {
      alert('尚無時間資料');
      return;
    }

    const date = new Date().toISOString().slice(0, 10);
    const totalCommute = calcRange(times.filter(t => t.type === 'commute'));
    const totalWork = calcRange(times.filter(t => t.type === 'work'));
    const totalShopping = calcRange(times.filter(t => t.type === 'shopping'));
    let content = '';
    let blob = null;
    let filename = '';

    if (type === 'csv') {
      const header = ['No.', 'DateTime', 'Checked', 'Type', 'Note'];
      const rows = times.map((t, i) => [
        i + 1,
        fmtEntry(new Date(t.t)),
        t.checked ? '✓' : '',
        t.type,
        t.note || ''
      ].map(csvEscape).join(','));
      content = '\uFEFF' + header.map(csvEscape).join(',') + '\n' + rows.join('\n') + `\n${csvEscape('Total Commute')},${csvEscape(totalCommute)}\n${csvEscape('Total Work')},${csvEscape(totalWork)}\n${csvEscape('Total Shopping')},${csvEscape(totalShopping)}`;
      blob = new Blob([content], { type: 'text/csv;charset=utf-8' });
      filename = `timeclock_${date}.csv`;
    } else if (type === 'txt') {
      const lines = times.map((t, i) => `${i + 1}. ${fmtEntry(new Date(t.t))} ${t.checked ? '✓' : ''} (${t.type}) ${t.note ? '- ' + t.note : ''}`);
      content = lines.join('\n') + `\n\nCOMMUTE ${totalCommute} | WORK ${totalWork} | SHOPPING ${totalShopping}`;
      blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      filename = `timeclock_${date}.txt`;
    } else if (type === 'md') {
      const rows = times.map((t, i) => `| ${i + 1} | ${fmtEntry(new Date(t.t))} | ${t.checked ? '✓' : ''} | ${t.type} | ${t.note || ''} |`);
      content = `| No. | DateTime | Checked | Type | Note |\n|---|---|---|---|---|\n${rows.join('\n')}\n| **Total Commute** | **${totalCommute}** |   |   |   |\n| **Total Work** | **${totalWork}** |   |   |   |\n| **Total Shopping** | **${totalShopping}** |   |   |   |`;
      blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
      filename = `timeclock_${date}.md`;
    }

    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  function updateNow() {
    const now = fmtDate(new Date());
    if (nowLabel) nowLabel.textContent = now;
    nowMiniLabel.textContent = now;
    sideNowLabel.textContent = now;
  }

  function initBtns() {
    document.getElementById('commuteBtn').onclick = () => addEntry('commute');
    document.getElementById('workBtn').onclick = () => addEntry('work');
    document.getElementById('shoppingBtn').onclick = () => addEntry('shopping');
    document.getElementById('clearBtn').onclick = clearAll;
    document.getElementById('exportBtn').onclick = () => {
      exportMenu.style.display = exportMenu.style.display === 'block' ? 'none' : 'block';
    };
    document.addEventListener('click', e => {
      if (!e.target.closest('.dropdown')) exportMenu.style.display = 'none';
    });
    exportMenu.querySelectorAll('button[data-export]').forEach(btn => {
      btn.addEventListener('click', () => exportAs(btn.dataset.export));
    });
  }

  function normalizeRemoteSnapshot(data) {
    if (!data) return [];
    if (Array.isArray(data)) return normalizeTimes(data);
    return normalizeTimes(Object.values(data));
  }

  function loadFromFirebase() {
    return fetch(firebaseDBUrl)
      .then(r => r.json())
      .then(data => {
        const remote = normalizeRemoteSnapshot(data);
        if (JSON.stringify(remote) !== JSON.stringify(times)) {
          times = remote;
          persistLocalCache();
          render();
        }
        setSyncState('SYNCING', new Date().toLocaleTimeString('zh-Hant'));
      })
      .catch(err => {
        console.error('load error', err);
        setSyncState('OFFLINE', lastSyncAt || '離線');
      });
  }

  function saveToFirebase() {
    persistLocalCache();
    setSyncState('SYNCING', lastSyncAt || new Date().toLocaleTimeString('zh-Hant'));
    return fetch(firebaseDBUrl, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(times)
    })
      .then(r => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const stamp = new Date().toLocaleTimeString('zh-Hant');
        setSyncState('SYNCING', stamp);
      })
      .catch(err => {
        console.error('save error', err);
        setSyncState('OFFLINE', lastSyncAt || '離線');
      });
  }

  function clearAll() {
    if (!confirm('確定清除全部時間？')) return;
    times = [];
    persistLocalCache();
    render();
    fetch(firebaseUserUrl, { method: 'DELETE' }).catch(err => console.error('clear error', err));
  }

  function syncFromFirebase() {
    loadFromFirebase();
  }

  initBtns();
  render();
  updateNow();
  setInterval(updateNow, 1000);
  setInterval(syncFromFirebase, 2000);
  window.addEventListener('load', syncFromFirebase);
</script>
</body>
</html>
